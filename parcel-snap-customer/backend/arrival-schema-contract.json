      "type": "timestamp with time zone",
      "not_null": false
    },
    {
      "name": "confirmed_by",
      "type": "uuid",
      "not_null": false
    },
    {
      "name": "created_at",
      "type": "timestamp with time zone",
      "not_null": true
    },
    {
      "name": "customer_id",
      "type": "uuid",
      "not_null": true
    },
    {
      "name": "error_message",
      "type": "text",
      "not_null": false
    },
    {
      "name": "event_type",
      "type": "text",
      "not_null": true
    },
    {
      "name": "facility_id",
      "type": "uuid",
      "not_null": true
    },
    {
      "name": "fingerprint",
      "type": "text",
      "not_null": true
    },
    {
      "name": "id",
      "type": "uuid",
      "not_null": true
    },
    {
      "name": "package_id",
      "type": "uuid",
      "not_null": true
    },
    {
